<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local secrets live outside the repo: dotnet user-secrets set "Storage:ConnectionString" "..." -->
    <UserSecretsId>todayinspace-web-7c1f3a2e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <!-- Draws the Earth snapshot PNG (/api/sky/earth.png). MIT licensed. The NoDependencies native build
         runs on the Linux App Service without extra system libraries (no fontconfig needed, the image has no text). -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zip code locations, read at startup by ZipLookup. Rebuilt by tools/build-zip-data.py. -->
    <Content Include="Data\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodayInSpace.Core\TodayInSpace.Core.csproj" />
  </ItemGroup>

</Project>
