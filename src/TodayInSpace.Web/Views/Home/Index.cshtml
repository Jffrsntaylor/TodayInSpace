@model TodayInSpace.Web.Models.DigestModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion
@{
    ViewData["Title"] = "Today in Space";
    Layout = null;

    // Same ?v= hash asp-append-version adds, for scripts sky-loader.js injects later.
    string Versioned(string path) => FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content(path));

    var sw = Model?.SpaceWeather;
    int kp = sw?.CurrentKp ?? -1;

    // Color-coding comes from SpaceWeatherHelper so the unit tests cover what's rendered.
    string kpClass = SpaceWeatherHelper.GetKpSeverity(sw?.CurrentKp);
    string kpDesc = kp >= 0 ? SpaceWeatherHelper.GetKpDescription(kp) : "";

    string aurora = (sw?.AuroraChance ?? "").ToUpper();
    string auroraClass = SpaceWeatherHelper.GetAuroraSeverity(aurora);
    string auroraSub = aurora switch
    {
        "POSSIBLE" => "high latitudes only",
        "LIKELY" => "mid to high latitudes",
        "STRONG" => "visible far south",
        "UNLIKELY" => "no activity expected",
        _ => ""
    };

    // Pretty date
    string prettyDate = "";
    if (!string.IsNullOrEmpty(Model?.Date) && DateTime.TryParse(Model.Date, out var d))
    {
        prettyDate = d.ToString("dddd, MMMM d, yyyy");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Today in Space</title>
    <partial name="_SocialMeta" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/space.css" asp-append-version="true" />
</head>
<body>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <div class="wrap">

        @* Back to top moves focus here, so keyboard users start over from the top too. *@
        <header class="masthead" id="top" tabindex="-1">
            <div class="eyebrow">Daily Digest</div>
            <h1>Today in Space</h1>
            <div class="date">@(string.IsNullOrEmpty(prettyDate) ? "Astronomy &amp; space-weather" : prettyDate)</div>
        </header>

        @* Sticky jump bar. Chips for sections the server didn't render are left out; section-nav.js hides
           and shows the rest as sky-core.js fills in (or gives up on) People, Launches and Satellites.
           Real links, so it still works without JS and links like /#launches can be shared. *@
        <nav class="section-nav" aria-label="Sections">
            <ul>
                @if (Model?.Apod != null)
                {
                    <li><a href="#apod">Picture</a></li>
                }
                @if (sw != null)
                {
                    <li><a href="#space-weather">Space Weather</a></li>
                }
                <li><a href="#your-sky">Your Sky</a></li>
                <li hidden><a href="#people">People</a></li>
                <li hidden><a href="#launches">Launches</a></li>
                <li hidden><a href="#satellites">Satellites</a></li>
                <li><a href="#live-sky">Live Sky</a></li>
            </ul>
        </nav>

        @if (Model?.Apod == null && sw == null)
        {
            <div class="empty">
                <p>No digest available right now. Check back after the next update.</p>
            </div>
        }
        else
        {
            @if (Model?.Apod != null)
            {
                <section id="apod" class="apod">
                    <div class="section-label">Astronomy Picture of the Day</div>
                    @{
                        var displaySrc = ApodImageHelper.GetDisplayUrl(Model.Apod);
                        var video = displaySrc == null ? ApodImageHelper.GetVideo(Model.Apod) : null;
                        var glowSrc = ApodImageHelper.GetGlowUrl(Model.Apod);
                    }
                    <div class="apod-stage">
                        @if (glowSrc != null)
                        {
                            <img class="apod-ambient" src="@glowSrc" alt="" aria-hidden="true" />
                        }
                        <div class="apod-frame">
                            @if (displaySrc != null)
                            {
                                <img src="@displaySrc" alt="@Model.Apod.Title" />
                            }
                            else if (video != null && video.Kind == VideoKind.Iframe)
                            {
                                <iframe src="@video.Src" title="@Model.Apod.Title" loading="lazy"
                                        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                                        allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            }
                            else if (video != null && video.Kind == VideoKind.File)
                            {
                                <video src="@video.Src" poster="@glowSrc" controls playsinline preload="metadata"
                                       aria-label="@Model.Apod.Title"></video>
                            }
                            else
                            {
                                <span class="placeholder">Image unavailable</span>
                            }
                        </div>
                    </div>
                    @if (ApodImageHelper.GetCarriedOverDate(Model) is DateTime carriedFrom)
                    {
                        <p class="apod-note">NASA&rsquo;s picture service was down during today&rsquo;s update, so this is the picture from @(carriedFrom.ToString("MMMM d")).</p>
                    }
                    <h2>@Model.Apod.Title</h2>
                    <p class="explain">@Model.Apod.Explanation</p>
                    @if (!string.IsNullOrEmpty(Model.Apod.Copyright))
                    {
                        <p class="credit">Credit &amp; Copyright: @Model.Apod.Copyright</p>
                    }
                </section>
            }

            @if (sw != null)
            {
                <section id="space-weather">
                    <div class="section-label">Space Weather</div>
                    <div class="cards">
                        <div class="card @kpClass">
                            <div class="label">Kp Index</div>
                            <div class="value">@(kp >= 0 ? kp.ToString() : "—")</div>
                            <div class="sub">@kpDesc</div>
                        </div>
                        <div class="card @auroraClass">
                            <div class="label">Aurora Chance</div>
                            <div class="value text">@(string.IsNullOrEmpty(aurora) ? "—" : aurora)</div>
                            <div class="sub">@auroraSub</div>
                        </div>
                        <div class="card info">
                            <div class="label">Solar Wind</div>
                            <div class="value">@(sw.SolarWindSpeed?.ToString() ?? "—")</div>
                            <div class="sub">km/s</div>
                        </div>
                    </div>

                    @if (sw.Forecast != null && sw.Forecast.Count > 0)
                    {
                        <div class="forecast">
                            <div class="section-label">3-Day Kp Forecast</div>
                            <div class="bars">
                                @foreach (var day in sw.Forecast)
                                {
                                    int dk = day.Kp ?? 0;
                                    int pct = SpaceWeatherHelper.GetForecastBarPercent(day.Kp);
                                    <div class="bar">
                                        <div class="num">@dk</div>
                                        <div class="track"><div class="fill" style="height:@(pct)%"></div></div>
                                        <div class="day">@day.Day</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        }

        @* "Your sky this week": visible-passes.js asks for a zip or the browser's location, then fills in
           visible satellite passes from /api/sky/visible. Without a location it shows only the form. *@
        <section id="your-sky" class="your-sky">
            <div class="section-label">Your sky this week</div>
            <div class="card sky-card">
                <form class="sky-where" id="sky-where" novalidate>
                    <label for="sky-zip">US zip code</label>
                    <div class="sky-zip-row">
                        <input id="sky-zip" name="zip" type="text" inputmode="numeric" maxlength="5" autocomplete="postal-code" placeholder="98501">
                        <button type="submit" class="chip">Go</button>
                    </div>
                    @* Shown by visible-passes.js only if the browser supports geolocation. *@
                    <button type="button" class="chip" id="sky-geo" hidden>Use my location</button>
                </form>
                <div class="sky-showing" id="sky-showing" hidden>
                    Showing <strong id="sky-place"></strong> &middot; <button type="button" class="sky-change" id="sky-change">Change</button>
                </div>
                <p class="sky-error" id="sky-error" role="alert" hidden></p>
                <p class="sky-intro" id="sky-intro">Enter a zip code or use your location to see when the ISS, Tiangong and Hubble will be visible from where you are over the next 7 days, plus the planets and Moon tonight.</p>
                @* Aurora odds and tonight's cloud cover, filled in by visible-passes.js. *@
                <div class="sky-conditions" id="sky-conditions" hidden></div>
                <div class="sky-passes" id="sky-passes" aria-live="polite"></div>
                <p class="sky-help" id="sky-help" hidden>Times in your time zone. Predictions can shift by a minute or two as orbits change.</p>
                @* Planets and the Moon tonight, filled in by visible-passes.js from the same response. *@
                <div class="sky-tonight" id="sky-tonight" hidden></div>
                <div class="source">Orbits: CelesTrak &middot; Planets: Astronomy Engine &middot; Aurora: NOAA SWPC &middot; Clouds: National Weather Service &middot; Zip locations: U.S. Census Bureau &middot; Zip names: <a href="https://www.geonames.org/" rel="noopener">GeoNames</a> (<a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>)</div>
            </div>
        </section>

        @* Filled in by sky-core.js from /api/sky/people. Stays hidden if the feed is unavailable. *@
        <section id="people" class="people" hidden>
            <div class="section-label">People in Space</div>
            <div class="card calm people-card">
                <div class="people-total">
                    <div class="value" id="people-count">&mdash;</div>
                    <div class="sub">people in space right now</div>
                </div>
                @* Station groups and name chips, built by sky-core.js. *@
                <div class="people-groups" id="people-groups" hidden></div>
                @* sky-core.js adds "updated N hours ago" from the API's timestamp. *@
                <div class="source" id="people-source">Source: The Space Devs</div>
            </div>
        </section>

        @* Filled in by sky-core.js from /api/sky/launches. Each half hides on its own if its data is missing,
           and the whole section stays hidden if both are. *@
        <section id="launches" class="launches" hidden>
            <div class="section-label">Launches</div>
            <div class="card info launches-card">
                <div class="launch-next" id="launch-next" hidden>
                    <div class="launch-next-head">
                        <h3 class="launch-heading">Next launch</h3>
                        @* Ticks every 30 seconds, so screen readers aren't told about each change. *@
                        <div class="launch-countdown" id="launch-countdown" aria-live="off" hidden></div>
                    </div>
                    <div class="launch-name" id="launch-name"></div>
                    <div class="launch-where" id="launch-where"></div>
                    <div class="launch-when">
                        <time id="launch-time"></time>
                        <span class="launch-status" id="launch-status"></span>
                    </div>
                </div>
                <div class="launch-year" id="launch-year" hidden>
                    <h3 class="launch-heading" id="launch-year-heading">Launches this year</h3>
                    <div class="value" id="launch-total">&mdash;</div>
                    <div class="sub" title="Every launch that tried to reach orbit, including failures. Suborbital flights aren't counted.">orbital launch attempts so far this year</div>
                    <div class="launch-outcomes" id="launch-outcomes"></div>
                    <ul class="launch-providers" id="launch-providers" hidden></ul>
                    <div class="launch-latest" id="launch-latest" hidden></div>
                </div>
                @* sky-core.js adds "updated N hours ago" from the API's timestamp. *@
                <div class="source" id="launches-source">Source: The Space Devs</div>
            </div>
        </section>

        @* Filled in by sky-core.js from /api/sky/satellites. Stays hidden if the feed is unavailable. *@
        <section id="satellites" class="satellites" hidden>
            <div class="section-label">Satellites</div>
            <div class="card info satellites-card">
                <div class="sat-total">
                    <div class="value" id="sat-active">&mdash;</div>
                    <div class="sub" title="Satellites CelesTrak lists as operational, partly operational, backup, spare or on an extended mission. Debris and rocket bodies aren't counted.">active satellites orbiting Earth</div>
                    <div class="sat-starlink" id="sat-starlink" hidden></div>
                </div>
                @* Uses the Launches card's bar rows, so both cards look the same. *@
                <ul class="launch-providers sat-owners" id="sat-owners" hidden></ul>
                <div class="sat-inventory" id="sat-inventory" hidden></div>
                @* sky-core.js adds the catalogue date and "checked N hours ago" from the API. *@
                <div class="source" id="satellites-source">Source: CelesTrak SATCAT</div>
            </div>
        </section>

        @* sky-loader.js reads these to load the globe and map libraries only when they're needed. *@
        <section id="live-sky" class="sky"
                 data-globe-lib="@Url.Content("~/lib/globe.gl/globe.gl.min.js")"
                 data-globe-src="@Versioned("~/js/sky-globe.js")"
                 data-leaflet-css="@Url.Content("~/lib/leaflet/leaflet.css")"
                 data-leaflet-js="@Url.Content("~/lib/leaflet/leaflet.js")"
                 data-map-src="@Versioned("~/js/sky-map.js")">
            <div class="sky-head">
                <div class="section-label">Live Sky</div>
                <div class="view-toggle" role="tablist" aria-label="Live Sky view">
                    <button type="button" role="tab" data-view="globe" aria-selected="true" aria-controls="sky-globe">Globe</button>
                    <button type="button" role="tab" data-view="map" aria-selected="false" aria-controls="sky-map" tabindex="-1">Map</button>
                </div>
            </div>
            <div class="sky-panel">
                <div id="sky-globe" class="sky-globe" data-earth-texture="/img/earth-blue-marble.jpg" data-night-texture="/img/earth-night-lights.jpg" aria-label="3D globe showing the International Space Station, the Hubble Space Telescope and the Tiangong space station, their orbits, and tonight's aurora forecast. Drag to rotate."><p class="sky-loading">Loading 3D globe&hellip;</p></div>
                <div id="sky-map" class="sky-map" hidden aria-label="World map showing the International Space Station, the Hubble Space Telescope and the Tiangong space station, their ground tracks, tonight's aurora forecast, and the part of Earth currently in darkness."></div>
                <div class="sky-readout">
                    <div class="sat-title">
                        <strong id="sat-name">International Space Station</strong>
                        <div class="sat-pick" role="group" aria-label="Choose a satellite">
                            <button type="button" class="chip" data-sat="iss" aria-pressed="true">ISS</button>
                            <button type="button" class="chip" data-sat="hubble" aria-pressed="false">Hubble</button>
                            <button type="button" class="chip" data-sat="tiangong" aria-pressed="false">Tiangong</button>
                            <button type="button" class="chip" id="sat-follow" aria-pressed="false">Follow</button>
                        </div>
                    </div>
                    <div class="stat"><span class="k">Latitude</span><span class="v" id="sat-lat">&mdash;</span></div>
                    <div class="stat"><span class="k">Longitude</span><span class="v" id="sat-lon">&mdash;</span></div>
                    <div class="stat"><span class="k">Altitude</span><span class="v" id="sat-alt">&mdash;</span></div>
                    <div class="stat"><span class="k">Speed</span><span class="v" id="sat-speed">&mdash;</span></div>
                </div>
                <div class="sky-legend">
                    <span><span class="line"></span>ISS orbit</span>
                    <span><span class="line" style="border-color:#ffc46b"></span>Hubble orbit</span>
                    <span><span class="line" style="border-color:#5fd3e6"></span>Tiangong orbit</span>
                    <span><span class="sw" style="background:#35d49a"></span>Aurora 5&ndash;15%</span>
                    <span><span class="sw" style="background:#7dffb3"></span>15&ndash;30%</span>
                    <span><span class="sw" style="background:#ffd166"></span>30&ndash;50%</span>
                    <span><span class="sw" style="background:#ff5d8f"></span>50%+</span>
                    <span data-view-only="map" hidden><span class="sw" style="background:#00030d;border:1px solid rgba(255,255,255,.25)"></span>Night side</span>
                    <span class="sky-hint" data-view-only="globe">Drag to spin &middot; scroll or pinch to zoom &middot; click a satellite</span>
                    <span class="status" id="sky-status" role="status"></span>
                </div>
            </div>
            <p class="sky-note">Positions of the ISS, Hubble and Tiangong are calculated live in your browser from each one&rsquo;s latest orbital elements (CelesTrak), at true altitude. Aurora forecast from NOAA&rsquo;s OVATION model, valid around <span id="aurora-time">&mdash;</span>. Earth imagery: NASA Blue Marble; city lights: NASA Earth Observatory / Black Marble.</p>
        </section>

        <footer class="foot">
            <div><a href="/Home/Archive" class="archive-link">View past forecasts &rarr;</a></div>
            <div style="margin-top:8px;">Updated daily &middot; Data: NASA APOD, NOAA SWPC</div>
        </footer>

    </div>
    <button type="button" class="to-top" id="to-top" aria-label="Back to top" hidden>&uarr;</button>
    <script src="~/lib/satellite.js/satellite.min.js"></script>
    <script src="~/js/sky-core.js" asp-append-version="true"></script>
    <script src="~/js/sky-loader.js" asp-append-version="true"></script>
    <script src="~/js/visible-passes.js" asp-append-version="true"></script>
    <script src="~/js/starfield.js" asp-append-version="true"></script>
    <script src="~/js/section-nav.js" asp-append-version="true" defer></script>
</body>
</html>
